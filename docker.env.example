MYSQL_ROOT_PASSWORD=change_me_before_start
MYSQL_APP_PASSWORD=change_me_to_an_independent_password
# 已有数据卷须先创建 rental_app 用户并授权 house_rental，详见 docs/security-fixes.md。
DEMO_ENABLED=false
PAYMENT_DEMO_MODE=false
# 当前示例为本地 HTTP；HTTPS 上线时设为 true。
SESSION_COOKIE_SECURE=false
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
RAG_EMBEDDING_API_KEY=your_dashscope_api_key
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=768
MYSQL_HOST_PORT=3307
WEB_HOST_PORT=5173
BACKEND_HOST_PORT=8080
AGENT_HOST_PORT=8001
