DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BASE_SECONDS=0.5
DEEPSEEK_INPUT_CACHE_HIT_CNY_PER_MILLION=0.02
DEEPSEEK_INPUT_CACHE_MISS_CNY_PER_MILLION=1.0
DEEPSEEK_OUTPUT_CNY_PER_MILLION=2.0
SPRING_BACKEND_URL=http://127.0.0.1:8080
REDIS_URL=redis://127.0.0.1:6379/0
CONVERSATION_TTL_SECONDS=3600
CONVERSATION_MAX_MESSAGES=12
CONVERSATION_RECENT_MESSAGES=8
APPOINTMENT_PENDING_TTL_SECONDS=900
RAG_DATABASE_PATH=data/rag/knowledge.db
RAG_KNOWLEDGE_DIR=knowledge
RAG_VECTOR_STORE=chroma
RAG_CHROMA_PATH=data/rag/chroma
RAG_CHROMA_COLLECTION=rental_knowledge
RAG_EMBEDDING_PROVIDER=openai_compatible
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v4
# 旧版本地服务兼容地址，仅在 RAG_EMBEDDING_PROVIDER=http 时使用
RAG_EMBEDDING_URL=http://127.0.0.1:9000/embeddings
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_DIMENSIONS=768
RAG_EMBEDDING_BATCH_SIZE=10
RAG_EMBEDDING_MAX_RETRIES=2
RAG_EMBEDDING_RETRY_BASE_SECONDS=0.5
RAG_TOP_K=3
RAG_CANDIDATE_K=10
RAG_VECTOR_WEIGHT=0.7
RAG_LEXICAL_WEIGHT=0.3
RAG_RERANK_WEIGHT=0.15
AGENT_HOST=127.0.0.1
AGENT_PORT=8001
AGENT_TOOL_LOG_PATH=logs/tool-calls.jsonl
AGENT_TOOL_LOG_MAX_BYTES=2097152
AGENT_TOOL_LOG_BACKUP_COUNT=3
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=house-rental-agent-dev
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
